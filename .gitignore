# ==============================================================================
# Local Data, Raw Documents, Scraped Artifacts, and Caches
# ==============================================================================
# Raw crawled documents and PDFs may contain copyrighted or sensitive documents
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/ocr_cache/*
!data/ocr_cache/.gitkeep
data/embeddings_cache/*
!data/embeddings_cache/.gitkeep

# Local database instances & exports
*.sqlite3
*.db
*.dump
*.sql.gz
postgres-data/
qdrant-storage/
opensearch-data/

# User query traces, metrics & logs (May contain PII under DPDP Act)
traces/
logs/
*.log
*.log.*
otel-traces/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==============================================================================
# Node.js & Web UI Artifacts
# ==============================================================================
web/node_modules/
node_modules/
web/.next/
web/out/
web/build/
web/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

