# ==============================================================================
# Security & Secrets (CRITICAL: NEVER COMMIT SECRETS TO PUBLIC REPOSITORIES)
# ==============================================================================
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Cloud and Provider Credentials
.aws/
.gcp/
.azure/
*service_account*.json
credentials.json
token.json

