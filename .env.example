# ==============================================================================
# Anupalan Environment Variables Template
# Copy this file to .env and populate with your local/testing credentials.
# WARNING: NEVER commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development                # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=anupalan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_placeholder@localhost:5432/anupalan

# Vector Database (Qdrant or pgvector)
VECTOR_BACKEND=pgvector                # pgvector | qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Lexical Search (PostgreSQL FTS or OpenSearch)
LEXICAL_BACKEND=postgres_fts           # postgres_fts | opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin_placeholder

# S3 / Object Store (MinIO or AWS S3 for raw documents)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=anupalan-raw-corpus
S3_REGION=ap-south-1

# LLM Providers (Configure whichever adapter you use)
# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI API (Optional alternative adapter)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Multilingual Embeddings & Reranker Models
EMBEDDING_PROVIDER=huggingface          # huggingface | openai | vertex
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# OCR Configuration
OCR_ENGINE=tesseract                   # tesseract | azure_doc_intelligence | google_doc_ai
TESSERACT_PATH=/usr/bin/tesseract

# Privacy & DPDP Retention Settings
QUERY_RETENTION_DAYS=30
ANONYMIZE_LOGS=true
REGION_RESTRICTION=IN
